# n8n Environment Variables
# Copy to .env and fill in values

# Domain & Protocol
N8N_HOST=n8n.yourdomain.com
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://n8n.yourdomain.com/

# PostgreSQL Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# Security (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# Timezone
GENERIC_TIMEZONE=Asia/Jerusalem
